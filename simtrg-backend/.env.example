# ==============================
# SIMTRG - Variables de Entorno
# ==============================

# Aplicación
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=simtrg_user
DB_PASSWORD=simtrg_secret_password
DB_DATABASE=simtrg_db
DB_SSL=false

# JWT
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRATION=8h

# Rate Limiting (peticiones por minuto por IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Almacenamiento de archivos
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE_MB=50

# Logs de auditoría
AUDIT_LOG_ENABLED=true
